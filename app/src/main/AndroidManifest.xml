<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Nötig, um zu prüfen, ob die Chat-App Dateien über "Teilen" annimmt (Android 11+ zeigt
        Apps sonst nicht). Gibt keinen Zugriff auf Daten anderer Apps.
    -->
    <!-- Skripte in Termux ausführen (nur nach Zustimmung des Nutzers, Termux fragt zusätzlich) -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <queries>
        <package android:name="com.termux" />
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND_MULTIPLE" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Einstellungen und Einrichtung -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Dateiauswahl für die Datei-Taste der Tastatur (durchsichtig, nur intern) -->
        <activity
            android:name=".FilePickerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:theme="@style/PickerTheme" />

        <!-- Anhänge: nur lesbar für Apps, denen die Tastatur es ausdrücklich erlaubt -->
        <provider
            android:name=".AttachmentProvider"
            android:authorities="de.hazeberry.keyboard.files"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Ergebnis von Termux (nur über den eigenen PendingIntent erreichbar) -->
        <receiver
            android:name=".TermuxResultReceiver"
            android:exported="false" />

        <!-- Die Tastatur -->
        <service
            android:name=".KeyboardService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Schnittstelle für Tasker -->
        <receiver
            android:name=".TaskerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="de.hazeberry.keyboard.ACTION_SIGNATURE_DUE" />
                <action android:name="de.hazeberry.keyboard.ACTION_RESET" />
                <action android:name="de.hazeberry.keyboard.ACTION_SET_SIGNATURE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
